# ULIX — annonce d'arrivée NCTS : réglages du poste.
#
# Copier ce fichier en « .env » à côté des dossiers de dépôt (le programme le
# fait seul au premier lancement) et compléter la clé. Le fichier .env n'est
# jamais versionné ni copié dans les annonces.
#
# Les variables déjà présentes dans l'environnement du système gardent la
# priorité sur ce fichier.

# --- Repli IA (lecture des pages que l'extraction déterministe rate) --------
# Clé d'accès Ollama (https://ollama.com/settings/keys) ou de tout serveur
# compatible OpenAI. Sans clé, le repli IA est simplement désactivé : le
# traitement déterministe (pdftotext + PaddleOCR) continue normalement.
OLLAMA_API_KEY=

# Serveur du modèle. Vide = https://ollama.com/v1 (Ollama cloud).
# Pour un Ollama local : http://localhost:11434/v1
OLLAMA_BASE_URL=

# Modèle vision utilisé en repli.
ULIX_IA_MODELE=deepseek-v4.1-flash:cloud

# Mettre « false » pour interdire tout appel au modèle, même avec une clé.
ULIX_IA_ACTIVE=true

# --- Emplacements (facultatif) ----------------------------------------------
# Dossier PROJET contenant « Dépots unique », « Dépots multiple »,
# « Annonces d'arrivées » et « Archive ». Vide = parent du dossier du programme.
# ULIX_PROJET=

# Dossiers de poppler si installés hors du PATH (séparés par « ; »
# sous Windows, « : » sinon). Inutile avec le paquet Windows : ils sont livrés.
# ULIX_BINAIRES=

# --- CargoWise (facultatif) --------------------------------------------------
# Renseigner uniquement dans le .env privé du poste, jamais dans cet exemple.
# Le MCP CargoWise direct testé ne nécessite pas --autoriser.
# --autoriser sert aux serveurs MCP protégés par OAuth (ancien IKAMO).
# CW_MCP_URL=
# CW_MCP_TOKEN=
